# Copy to .env.local for local development.
#
# In CI these are NOT read from a file — Bacano sets them as GitHub repository
# *variables* when the site is provisioned, and .github/workflows/deploy.yml
# passes them to the build. None of them are secret: everything here ends up in
# the browser bundle by design.

# Bacano public API. Same for every storefront.
NEXT_PUBLIC_BACANO_API_URL=https://api.bacanoerp.com

# Identifies this storefront to the API. Must match the website's slug in the
# Bacano platform, or the build resolves no catalogue at all.
NEXT_PUBLIC_BACANO_WEBSITE_SLUG=my-store

# Canonical public URL, used for metadata and OpenGraph tags.
NEXT_PUBLIC_SITE_URL=https://my-store.sites.bacano.app

# Display name in the header, page titles and footer.
NEXT_PUBLIC_SITE_NAME=My Store

# Clerk publishable key for THIS storefront's Clerk application. Buyer
# credentials belong to Clerk, never to Bacano. The secret key is never used
# here — if you find yourself needing it in this repo, something is wrong.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
