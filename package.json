{
  "name": "bacano-website-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "next build",
    "check": "biome check .",
    "check:disclosure": "node scripts/check-disclosure.mjs",
    "check:fix": "biome check --write .",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "dev": "next dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "eslint .",
    "start": "npx serve@latest out",
    "test:e2e": "node scripts/test-static.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm check && pnpm lint && pnpm check:disclosure",
    "verify:all": "pnpm verify && pnpm test:e2e"
  },
  "dependencies": {
    "@bacano/sdk": "^1.1.18",
    "@clerk/localizations": "^4.13.3",
    "@clerk/react": "^6.12.3",
    "next": "16.2.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@playwright/test": "1.58.0",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
